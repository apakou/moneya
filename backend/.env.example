# Copy to .env (never commit). Values for local/testnet only.
NODE_ENV=development
PORT=3000

# --- Stellar (see docs/backend/stellar-mvp-plan.md) ---
# TESTNET or PUBLIC
STELLAR_NETWORK=TESTNET
# Comma-separated, independent providers (failover order)
STELLAR_HORIZON_URLS=https://horizon-testnet.stellar.org
# Circle USDC issuer account for the chosen network. VERIFY against Circle's
# official documentation before use; there is deliberately no default.
STELLAR_USDC_ISSUER=
