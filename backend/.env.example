# Copy to .env (never commit). Values for local/testnet only.
NODE_ENV=development
PORT=3000

# --- Stellar (see docs/backend/stellar-mvp-plan.md) ---
# TESTNET or PUBLIC
STELLAR_NETWORK=TESTNET
# Comma-separated, independent providers (failover order)
STELLAR_HORIZON_URLS=https://horizon-testnet.stellar.org
# Circle USDC issuer account for the chosen network. VERIFY against Circle's
# official documentation before use; there is deliberately no default.
STELLAR_USDC_ISSUER=

# --- SMS (OTP) ---
# fake (dev/test, nothing is sent) or http (any aggregator with an HTTP API). `fake` is refused in production.
SMS_PROVIDER=fake
# For http: JSON array, tried in order (failover). Keep it in a secret store, not in git.
# Example (shape only — verify the provider's real endpoint and fields against its docs):
# SMS_HTTP_CONFIGS=[{"url":"https://sms.example.com/v1/send","format":"json","headers":{"Authorization":"Bearer <token>"},"sender":"MoneyA"}]

# --- Ramp (fiat collect/payout) ---
# simulated (dev/test) — refused in production until a real provider adapter exists.
RAMP_PROVIDER=simulated
# RAMP_WEBHOOK_SECRET=

# --- Database (Supabase = managed PostgreSQL; see docs/backend/supabase.md) ---
# Do NOT put sslmode in the URL; use DATABASE_SSL / DATABASE_CA_CERT.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@<pooler-host>:5432/postgres
# DATABASE_CA_CERT=   # PEM of Supabase's "SSL certificate"
# DATABASE_SSL=true
# DATABASE_POOL_MAX=10

# --- Dev only ---
# Print one-time codes to the API console when SMS_PROVIDER=fake (ignored when NODE_ENV=production).
# FAKE_SMS_LOG=true
